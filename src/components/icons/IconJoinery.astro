---
// Joinery icon: pillar strokes + dovetail-notch details cut into the
// centre pillar, echoing the logo's vertical pillar-stroke geometry with a
// joinery craft detail.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <line x1="15" y1="10" x2="15" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <path
    d="M24,8 L24,17 L20,20 L24,23 L24,25 L20,28 L24,31 L24,40"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <line x1="33" y1="10" x2="33" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="11" y1="10" x2="19" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="11" y1="38" x2="19" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="29" y1="10" x2="37" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="29" y1="38" x2="37" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <path d="M28,20 L31,20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <path d="M28,28 L31,28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
</svg>
