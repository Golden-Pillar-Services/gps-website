---
// Joinery icon, redrawn in technical-drawing grammar: a section-view
// panel outline with a dovetail joint detail (real joinery construction
// technique, not a generic craft flourish) and dimension ticks — reads
// as a shop drawing detail, not an icon-pack glyph.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <!-- Panel section outline -->
  <rect x="10" y="10" width="28" height="28" stroke="currentColor" stroke-width="1.5" />
  <!-- Dovetail joint detail (real joinery technique) -->
  <path
    d="M10 20 L16 20 L18 17 L20 20 L22 20 L22 28 L20 28 L18 31 L16 28 L10 28"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linejoin="round"
  />
  <!-- Dimension line + ticks below the panel -->
  <line x1="10" y1="42" x2="38" y2="42" stroke="currentColor" stroke-width="1" />
  <line x1="10" y1="44" x2="10" y2="40" stroke="currentColor" stroke-width="1" />
  <line x1="38" y1="44" x2="38" y2="40" stroke="currentColor" stroke-width="1" />
</svg>
