---
// Cleaning icon, redrawn in technical-drawing grammar: a swept-area
// boundary (dashed, like a scope-of-work hatch outline) with a coverage
// arc dimension line and a survey node — not a literal broom/spray glyph.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <!-- Swept-area boundary, dashed like a hatch/scope outline -->
  <path d="M8 38 Q24 10 40 18" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.5 3" stroke-linecap="round" />
  <!-- Baseline with dimension ticks -->
  <line x1="8" y1="38" x2="40" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="8" y1="41" x2="8" y2="35" stroke="currentColor" stroke-width="1" />
  <line x1="40" y1="41" x2="40" y2="35" stroke="currentColor" stroke-width="1" />
  <!-- Coverage arc endpoint marker -->
  <line x1="35" y1="14" x2="40" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="36" y1="21" x2="40" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <!-- Survey node -->
  <circle cx="24" cy="24" r="1.6" fill="currentColor" stroke="none" />
</svg>
