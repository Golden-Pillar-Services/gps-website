---
// Signage icon: pillar strokes + a rectangular sign panel mounted between
// them, echoing the logo's vertical pillar-stroke geometry.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <line x1="15" y1="10" x2="15" y2="40" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="33" y1="10" x2="33" y2="40" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="11" y1="36" x2="19" y2="36" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <line x1="29" y1="36" x2="37" y2="36" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <rect x="10" y="15" width="28" height="11" rx="1" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
  <line x1="15" y1="20.5" x2="33" y2="20.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
</svg>
