---
// Signage icon, redrawn in technical-drawing grammar: a sign panel
// elevation on a mounting post, a leader line calling out the panel
// (real drawing-annotation convention) and a baseline with dimension
// ticks — matches the DimensionLine/CoordinateTag system.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <!-- Sign panel -->
  <rect x="9" y="10" width="30" height="14" stroke="currentColor" stroke-width="1.5" />
  <line x1="13" y1="17" x2="35" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <!-- Mounting post -->
  <line x1="24" y1="24" x2="24" y2="38" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <!-- Leader line + callout node (drawing-annotation convention) -->
  <line x1="39" y1="14" x2="44" y2="10" stroke="currentColor" stroke-width="1" stroke-dasharray="1.5 2" />
  <circle cx="44" cy="10" r="1.4" fill="currentColor" stroke="none" />
  <!-- Baseline with dimension ticks -->
  <line x1="10" y1="42" x2="38" y2="42" stroke="currentColor" stroke-width="1" />
  <line x1="10" y1="44" x2="10" y2="40" stroke="currentColor" stroke-width="1" />
  <line x1="38" y1="44" x2="38" y2="40" stroke="currentColor" stroke-width="1" />
</svg>
