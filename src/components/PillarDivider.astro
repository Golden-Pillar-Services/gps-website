---
// Small section divider echoing the four pillar strokes from the logo mark,
// flanked by hairlines. The pillar glyph is the logo-square geometry
// recolored entirely to gold for use on light or dark section backgrounds.
import logoSquareRaw from '../assets/logo-square.svg?raw';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

// Strip the source's <style> block (class names .st0/.st1) and bake
// `currentColor` into fill attributes directly instead — an inline SVG's
// <style> applies document-wide, not just to its own subtree, so leaving
// it in place collides with any other component reusing the same class
// names from the same logo family (see Header.astro for the same fix and
// the full explanation — this is what caused it in the first place).
const pillarGlyph = logoSquareRaw
  .replace(/<style>[\s\S]*?<\/style>/, '')
  .replaceAll('class="st0"', 'fill="currentColor"')
  .replaceAll('class="st1"', 'fill="currentColor"')
  .replace('<svg ', '<svg class="h-6 w-6" ');
---

<div
  class={`flex items-center justify-center gap-4 py-2 text-gold ${className}`}
  role="presentation"
  aria-hidden="true"
>
  <span class="h-px w-16 bg-current opacity-30"></span>
  <Fragment set:html={pillarGlyph} />
  <span class="h-px w-16 bg-current opacity-30"></span>
</div>
