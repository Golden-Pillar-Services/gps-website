---
// Logo-derived pillar line-draw mark. Reuses the exact interlocking-pillar
// polygon coordinates from src/assets/logo-full.svg's icon mark (the
// wordmark's leading glyph, before the "Golden Pillar" text), stroked only
// (fill: none) so the shape can be revealed with a stroke-dasharray draw
// animation.
//
// `animate` (default true) plays a once-on-load draw-in, staggered per
// polygon. Guarded by prefers-reduced-motion: reduced-motion users get the
// mark fully drawn immediately, no animation, no risk of a stuck-invisible
// shape (mirrors the [data-reveal] pattern in global.css).
interface Props {
  class?: string;
  animate?: boolean;
}

const { class: className, animate = true } = Astro.props;
---

<svg
  viewBox="0 0 250 309"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['gp-pillar-draw', animate && 'gp-pillar-draw--animate', className]}
  aria-hidden="true"
>
  <polygon points="0 237.6 0 209.2 24 224.7 24 85.9 86.3 43.6 86.3 74.9 49.2 99.1 49.2 266 0 237.6" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" pathLength="1" />
  <polygon points="200.5 266 200.5 99.1 163.4 74.9 163.4 43.6 225.7 85.9 225.7 224.7 249.7 209.2 249.7 237.6 200.5 266" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" pathLength="1" />
  <polygon points="127.6 308.1 127.6 0 153.2 19 153.2 265.9 163.4 260.2 163.4 125.5 187 111.8 187 273.8 127.6 308.1" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" pathLength="1" />
  <polygon points="62.7 273.8 62.7 111.8 86.3 125.5 86.3 260.2 96.5 265.9 96.5 19 122.1 0 122.1 308.1 62.7 273.8" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" pathLength="1" />
</svg>

<style>
  /* Default (and reduced-motion) state: fully drawn, always visible. */
  .gp-pillar-draw polygon {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gp-pillar-draw--animate polygon {
      stroke-dashoffset: 1;
      animation: gp-pillar-draw 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .gp-pillar-draw--animate polygon:nth-of-type(1) { animation-delay: 0.05s; }
    .gp-pillar-draw--animate polygon:nth-of-type(2) { animation-delay: 0.2s; }
    .gp-pillar-draw--animate polygon:nth-of-type(3) { animation-delay: 0.35s; }
    .gp-pillar-draw--animate polygon:nth-of-type(4) { animation-delay: 0.5s; }
  }

  @keyframes gp-pillar-draw {
    to { stroke-dashoffset: 0; }
  }
</style>
