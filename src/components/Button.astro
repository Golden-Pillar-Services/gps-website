---
// Shared CTA button atom. Three variants:
//   gold        — solid gold background, charcoal text (primary CTA)
//   outline     — gold hairline border, gold text, fills gold on hover
//   ghost-light — no fill, light (ivory) text for dark backgrounds, with a
//                 gold underline-sweep revealed on hover
import { buttonBase, buttonVariants, type ButtonVariant } from '../lib/buttonStyles';

interface Props {
  href: string;
  variant?: ButtonVariant;
  class?: string;
}

const { href, variant = 'gold', class: className } = Astro.props;
---

<a href={href} class:list={[buttonBase, buttonVariants[variant], className]}>
  <slot />
</a>

<style>
  /* Gold underline-sweep on hover, for the ghost-light variant. */
  .gp-btn-ghost {
    position: relative;
    padding-inline: 0.25rem;
    border-radius: 0;
  }
  .gp-btn-ghost::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [dir='rtl'] .gp-btn-ghost::after {
    transform-origin: right;
  }
  .gp-btn-ghost:hover::after,
  .gp-btn-ghost:focus-visible::after {
    transform: scaleX(1);
  }
</style>
