---
// Shared section heading atom: gold hairline + uppercase eyebrow, a
// Fraunces (font-display) title, and an optional supporting subtext.
interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  class?: string;
  /** Heading level to render for the title. Defaults to h2; pass "h1" when
   * this SectionHeading is a page's single top-level heading. */
  as?: 'h1' | 'h2';
  /** Set on a charcoal/dark section so title/sub switch to light text. */
  dark?: boolean;
}

const { eyebrow, title, sub, class: className, as: Tag = 'h2', dark = false } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
  {eyebrow && (
    <div class="mb-3 flex items-center gap-3">
      <span class:list={['h-px w-8', dark ? 'bg-gold-light/70' : 'bg-gold']} aria-hidden="true"></span>
      <span
        class:list={[
          'font-mono text-[0.7rem] uppercase tracking-[0.18em]',
          dark ? 'text-gold-light/90' : 'text-gold',
        ]}
      >
        {eyebrow}
      </span>
    </div>
  )}
  <Tag class:list={['font-display text-3xl font-semibold sm:text-4xl', dark ? 'text-ivory' : 'text-ink']}>
    {title}
  </Tag>
  {sub && <p class:list={['mt-4 text-base sm:text-lg', dark ? 'text-ivory/70' : 'text-stone-dark']}>{sub}</p>}
</div>
