---
// Shared section heading atom: a Fraunces (font-display) title and an
// optional supporting subtext. No eyebrow/kicker here deliberately — the
// survey/blueprint motifs (title block, coordinate tag, dimension line)
// are this site's one recurring "technical label" device, used on page
// heroes; putting a tracked mono eyebrow above every single section on
// top of that would be exactly the over-used-eyebrow pattern DESIGN.md
// and the design floor both call out. Section rhythm instead comes from
// the survey motifs used sparingly plus plain, confident typography.
interface Props {
  title: string;
  sub?: string;
  class?: string;
  /** Heading level to render for the title. Defaults to h2; pass "h1" when
   * this SectionHeading is a page's single top-level heading. */
  as?: 'h1' | 'h2';
  /** Set on a charcoal/dark section so title/sub switch to light text. */
  dark?: boolean;
}

const { title, sub, class: className, as: Tag = 'h2', dark = false } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
  <Tag class:list={['font-display text-3xl font-semibold sm:text-4xl', dark ? 'text-ivory' : 'text-ink']}>
    {title}
  </Tag>
  {sub && <p class:list={['mt-4 text-base sm:text-lg', dark ? 'text-ivory/70' : 'text-stone-dark']}>{sub}</p>}
</div>
