---
import { t, localePath, type Lang } from '../i18n';
import { company } from '../data/company';
import { services } from '../data/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const year = new Date().getFullYear();

const quickLinks = [
  { href: localePath(lang, '/'), label: dict.nav.home },
  { href: localePath(lang, '/about'), label: dict.nav.about },
  { href: localePath(lang, '/projects'), label: dict.nav.projects },
  { href: localePath(lang, '/contact'), label: dict.nav.contact },
];
---

<footer class="border-t-2 border-gold bg-charcoal text-ivory">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-lg font-semibold text-ivory">
          {lang === 'ar' ? company.nameAr : company.nameEn}
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ivory/70">
          {dict.footer.tagline}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold-light">
          {dict.footer.servicesTitle}
        </h3>
        <ul class="mt-4 space-y-2">
          {services.map((service) => (
            <li>
              <a
                href={localePath(lang, `/services/${service.slug}`)}
                class="text-sm text-ivory/80 transition-colors hover:text-gold-light"
              >
                {lang === 'ar' ? service.title.ar : service.title.en}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold-light">
          {dict.footer.quickLinksTitle}
        </h3>
        <ul class="mt-4 space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ivory/80 transition-colors hover:text-gold-light">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold-light">
          {dict.footer.contactTitle}
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-ivory/80">
          <li>
            <a href={`tel:${company.phone.replace(/\s+/g, '')}`} class="transition-colors hover:text-gold-light">
              {company.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${company.email}`} class="transition-colors hover:text-gold-light">
              {company.email}
            </a>
          </li>
          <li>{lang === 'ar' ? company.address.ar : company.address.en}</li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-ivory/10 pt-6 text-xs text-ivory/60 sm:flex-row sm:items-center sm:justify-between">
      <p>{lang === 'ar' ? `س.ت ${company.crNumber}` : `CR No. ${company.crNumber}`}</p>
      <p>&copy; {year} {lang === 'ar' ? company.nameAr : company.nameEn}. {dict.footer.rights}</p>
    </div>
  </div>
</footer>
