---
import { t, localePath, type Lang } from '../i18n';
import { company } from '../data/company';
import { services } from '../data/services';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const year = new Date().getFullYear();

const quickLinks = [
  { href: localePath(lang, '/'), label: dict.nav.home },
  { href: localePath(lang, '/about'), label: dict.nav.about },
  { href: localePath(lang, '/projects'), label: dict.nav.projects },
  { href: localePath(lang, '/contact'), label: dict.nav.contact },
];
---

<footer class="border-t-2 border-gold bg-charcoal text-ivory">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-lg font-semibold text-ivory">
          {lang === 'ar' ? company.nameAr : company.nameEn}
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ivory/70">
          {dict.footer.tagline}
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold-light">
          {dict.footer.servicesTitle}
        </h3>
        <ul class="mt-4 space-y-2">
          {services.map((service) => (
            <li>
              <a
                href={localePath(lang, `/services/${service.slug}`)}
                class="text-sm text-ivory/80 transition-colors hover:text-gold-light"
              >
                {lang === 'ar' ? service.title.ar : service.title.en}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold-light">
          {dict.footer.quickLinksTitle}
        </h3>
        <ul class="mt-4 space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ivory/80 transition-colors hover:text-gold-light">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wide text-gold-light">
          {dict.footer.contactTitle}
        </h3>
        <ul class="mt-4 space-y-2 text-sm text-ivory/80">
          <li>
            <a href={`tel:${company.phone.replace(/\s+/g, '')}`} class="transition-colors hover:text-gold-light">
              {company.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${company.email}`} class="transition-colors hover:text-gold-light">
              {company.email}
            </a>
          </li>
          <li>{lang === 'ar' ? company.address.ar : company.address.en}</li>
        </ul>

        <ul class="mt-4 flex items-center gap-3">
          <li>
            <a
              href={company.socials.instagram}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-ivory/20 text-ivory/80 transition-colors hover:border-gold-light hover:text-gold-light"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href={company.socials.linkedin}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-ivory/20 text-ivory/80 transition-colors hover:border-gold-light hover:text-gold-light"
              aria-label="LinkedIn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3 8.98h4v11.52H3zM9.5 8.98h3.83v1.57h.05c.53-.97 1.84-2 3.79-2 4.06 0 4.81 2.5 4.81 5.75v6.2h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.4-2.11 2.9v5.6h-4V8.98Z" />
              </svg>
            </a>
          </li>
          <li>
            <a
              href={company.socials.facebook}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-ivory/20 text-ivory/80 transition-colors hover:border-gold-light hover:text-gold-light"
              aria-label="Facebook"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M14 22v-8h2.7l.4-3H14V9c0-.87.24-1.46 1.5-1.46H17V4.9c-.26-.04-1.15-.11-2.19-.11-2.17 0-3.66 1.32-3.66 3.76V11H8.5v3H11.15v8H14Z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-ivory/10 pt-6 text-xs text-ivory/60 sm:flex-row sm:items-center sm:justify-between">
      <p>{lang === 'ar' ? `س.ت ${company.crNumber}` : `CR No. ${company.crNumber}`}</p>
      <p>&copy; {year} {lang === 'ar' ? company.nameAr : company.nameEn}. {dict.footer.rights}</p>
    </div>
  </div>
</footer>
