---
// Shared dark page-hero: full-bleed photo, heavy bottom gradient, corner
// registration marks, monospace eyebrow label — the same language as the
// home hero, reused by every secondary page so light-centered "template"
// heroes don't come back page by page.
import { type Lang } from '../i18n';
import Reveal from './Reveal.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  sub?: string;
  image: ImageMetadata;
}

const { eyebrow, title, sub, image } = Astro.props;
---

<section class="relative min-h-[60vh] overflow-hidden bg-charcoal sm:min-h-[65vh]">
  <Image
    src={image}
    alt=""
    widths={[960, 1400, 1800]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-linear-to-t from-charcoal from-15% via-charcoal/85 via-55% to-charcoal/30" aria-hidden="true"></div>

  <div class="pointer-events-none absolute inset-6 hidden sm:inset-10 sm:block" aria-hidden="true">
    <span class="absolute start-0 top-0 h-7 w-7 border-t-2 border-s-2 border-gold-light/50"></span>
    <span class="absolute end-0 top-0 h-7 w-7 border-t-2 border-e-2 border-gold-light/50"></span>
  </div>

  <div class="relative flex min-h-[60vh] flex-col justify-end px-6 pb-16 pt-28 sm:min-h-[65vh] sm:px-10 lg:px-16">
    <Reveal class="mb-4 flex items-center gap-3 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-gold-light/90">
      <span class="h-px w-8 bg-gold-light/70" aria-hidden="true"></span>
      <span>{eyebrow}</span>
    </Reveal>
    <Reveal delay={1}>
      <h1 class="max-w-2xl font-display text-4xl font-semibold leading-[1.02] tracking-tight text-ivory drop-shadow-[0_2px_16px_rgba(0,0,0,0.5)] sm:text-6xl">
        {title}
      </h1>
    </Reveal>
    {sub && (
      <Reveal delay={2} class="mt-5 max-w-lg text-base text-ivory/75 sm:text-lg">
        <p>{sub}</p>
      </Reveal>
    )}
  </div>

  <div class="absolute inset-x-0 bottom-0 h-px bg-gold/50" aria-hidden="true"></div>
</section>
