---
// Shared stat atom: a big animated counter (see src/scripts/counters.ts +
// the [data-counter] markup contract) with a label underneath.
interface Props {
  /** Numeric target value the counter animates up to. */
  value: number;
  label: string;
  /** Optional string appended after the number, e.g. '+', '%'. */
  suffix?: string;
  class?: string;
  /** Set on a charcoal/dark section so the label switches to light text. */
  dark?: boolean;
}

const { value, label, suffix, class: className, dark = false } = Astro.props;
---

<div class:list={['text-center', className]}>
  <p class:list={['font-display text-4xl font-semibold sm:text-5xl', dark ? 'text-gold-light' : 'text-gold']}>
    <span data-counter={value}>0</span>{suffix}
  </p>
  <p
    class:list={[
      'mt-2 font-mono text-xs uppercase tracking-[0.14em]',
      dark ? 'text-ivory/60' : 'text-stone-dark',
    ]}
  >
    {label}
  </p>
</div>
