---
// Shared stat atom: a big animated counter (see src/scripts/counters.ts +
// the [data-counter] markup contract) with a label underneath.
interface Props {
  /** Numeric target value the counter animates up to. */
  value: number;
  label: string;
  /** Optional string appended after the number, e.g. '+', '%'. */
  suffix?: string;
  class?: string;
}

const { value, label, suffix, class: className } = Astro.props;
---

<div class:list={['text-center', className]}>
  <p class="font-display text-4xl font-semibold text-gold sm:text-5xl">
    <span data-counter={value}>0</span>{suffix}
  </p>
  <p class="mt-2 text-sm font-medium uppercase tracking-wide text-stone">{label}</p>
</div>
