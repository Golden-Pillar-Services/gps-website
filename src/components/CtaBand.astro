---
// Shared closing CTA band: charcoal background, Fraunces headline, gold +
// WhatsApp CTAs. Used on the home page and reused by Services/About/
// Projects/Contact pages, so it lives at the shared component path rather
// than nested under components/home/.
import { t, localePath, type Lang } from '../i18n';
import { company } from '../data/company';
import Reveal from './Reveal.astro';
import Button from './Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const today = new Date();
---

<section class="relative overflow-hidden border-t border-gold/30 bg-charcoal">
  <div class="pointer-events-none absolute inset-6 hidden sm:inset-10 sm:block" aria-hidden="true">
    <span class="absolute start-0 top-0 h-7 w-7 border-t-2 border-s-2 border-gold-light/30"></span>
    <span class="absolute end-0 bottom-0 h-7 w-7 border-b-2 border-e-2 border-gold-light/30"></span>
  </div>
  <div class="relative mx-auto max-w-3xl px-4 pt-24 text-center sm:px-6">
    <Reveal>
      <h2 class="font-display text-3xl font-semibold text-ivory sm:text-4xl">
        {dict.home.ctaBand.title}
      </h2>
    </Reveal>
    <Reveal delay={1}>
      <p class="mx-auto mt-4 max-w-xl text-base text-ivory/75 sm:text-lg">
        {dict.home.ctaBand.sub}
      </p>
    </Reveal>
    <Reveal delay={2} class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <Button href={localePath(lang, '/contact')} variant="gold">{dict.cta.getQuote}</Button>
      <Button href={company.whatsappLink} variant="outline">{dict.cta.whatsapp}</Button>
    </Reveal>
  </div>

  {/* Sheet footer — closes the title-block system every page hero opens
      with, rather than a centered eyebrow repeating the company name. */}
  <div class="relative mt-16 border-t border-gold-light/20">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-4 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-gold-light/60 sm:px-6">
      <span>{lang === 'ar' ? company.nameAr : company.nameEn}</span>
      <span>{lang === 'ar' ? `مراجعة ${today.getFullYear()}` : `REV. ${today.getFullYear()}`}</span>
    </div>
  </div>
</section>
