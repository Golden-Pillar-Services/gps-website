---
// Shared popover body listing every live WhatsApp contact — used inside
// a <details> by both WhatsAppChooser.astro (inline CTA trigger) and
// WhatsAppFloat.astro (the fixed circular button), so the two never
// drift out of sync.
import { company } from '../data/company';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Opens above the trigger instead of below — for the fixed floating
   * button, which sits at the bottom of the viewport. */
  openUp?: boolean;
}

const { lang, openUp = false } = Astro.props;
const dict = t(lang);
const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .join('')
    .toUpperCase();
---

<div
  class:list={[
    'absolute z-40 w-64 border border-gold/25 bg-charcoal shadow-2xl',
    openUp ? 'bottom-full end-0 mb-3' : 'top-full start-0 mt-2',
  ]}
>
  <p class="border-b border-gold-light/15 px-4 py-2.5 font-mono text-[0.65rem] uppercase tracking-[0.14em] text-gold-light/70">
    {dict.cta.whatsappChoose}
  </p>
  <div class="divide-y divide-gold-light/10">
    {company.whatsappNumbers.map((n) => (
      <a
        href={n.link}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-gold/10"
      >
        <span
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold/15 font-display text-sm font-semibold text-gold-light"
          aria-hidden="true"
        >
          {initials(n.name)}
        </span>
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold text-ivory">{n.name}</span>
          <span dir="ltr" class="block text-xs text-ivory/55">{n.label}</span>
        </span>
      </a>
    ))}
  </div>
</div>
