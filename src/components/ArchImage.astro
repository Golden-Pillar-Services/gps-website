---
// ArchImage: responsive, optimized photo clipped to a subtle arch-top
// shape (square/soft corners at the bottom, generous rounding at the top),
// echoing the pillar/archway visual language used across the site.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  widths?: number[];
  sizes?: string;
}

const {
  src,
  alt,
  class: className,
  loading = 'lazy',
  widths = [480, 800, 1200],
  sizes = '(min-width: 1024px) 33vw, 100vw',
} = Astro.props;
---

<div class:list={['gp-arch-image overflow-hidden', className]}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="avif"
    loading={loading}
    class="h-full w-full object-cover"
  />
</div>

<style>
  .gp-arch-image {
    /* Subtle arch: generous rounding at the top corners only, tuned to
       read as an architectural arch rather than a full pill. */
    border-radius: 999px 999px 240px 240px / 120px 120px 24px 24px;
  }
</style>
