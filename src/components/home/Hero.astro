---
// Home page hero, v2: full-bleed site photograph as the entire canvas
// (not a 50/50 split), heavy bottom-weighted gradient, text anchored low
// rather than centered, a monospace "spec sheet" label row + corner
// registration marks for a precision/engineered feel, and one italic
// word in the headline for emphasis — closer to the bold, dark, textured
// reference direction than the earlier split-hero version.
import { t, localePath, type Lang } from '../../i18n';
import { company } from '../../data/company';
import { services } from '../../data/services';
import Reveal from '../Reveal.astro';
import Button from '../Button.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/img/hero-fitout.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const heroLines = dict.home.heroTitle.split('\n');
const specLabel = [
  lang === 'ar' ? 'سلطنة عُمان' : 'OMAN',
  lang === 'ar' ? 'تأسست 2012' : 'EST. 2012',
  services.map((s) => (lang === 'ar' ? s.title.ar : s.title.en)).join(' / '),
].join('  ·  ');
---

<section class="relative min-h-screen overflow-hidden bg-charcoal">
  <Image
    src={heroImg}
    alt=""
    widths={[960, 1400, 1800, 2200]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover"
  />
  {/* Bottom-weighted gradient — photo stays clearly visible in the top
      third, darkens enough behind the text block (roughly the bottom
      two-thirds) for guaranteed contrast against busy site photography. */}
  <div class="absolute inset-0 bg-linear-to-t from-charcoal from-10% via-charcoal/90 via-45% to-transparent to-85%" aria-hidden="true"></div>

  {/* Corner registration marks — a precision/blueprint device instead of
      a decorative flourish, reinforcing "measured, engineered work". */}
  <div class="pointer-events-none absolute inset-6 hidden sm:inset-10 sm:block" aria-hidden="true">
    <span class="absolute start-0 top-0 h-8 w-8 border-t-2 border-s-2 border-gold-light/60"></span>
    <span class="absolute end-0 top-0 h-8 w-8 border-t-2 border-e-2 border-gold-light/60"></span>
    <span class="absolute start-0 bottom-0 h-8 w-8 border-b-2 border-s-2 border-gold-light/60"></span>
    <span class="absolute end-0 bottom-0 h-8 w-8 border-b-2 border-e-2 border-gold-light/60"></span>
  </div>

  <div class="relative flex min-h-screen flex-col justify-end px-6 pb-16 pt-32 sm:px-10 sm:pb-20 lg:px-16 lg:pb-24">
    <Reveal class="mb-5 flex items-center gap-3 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-gold-light/90 sm:text-xs">
      <span class="h-px w-8 bg-gold-light/70" aria-hidden="true"></span>
      <span>{specLabel}</span>
    </Reveal>

    <h1 class="max-w-4xl font-display text-[3rem] font-semibold leading-[0.95] tracking-tight text-ivory drop-shadow-[0_2px_16px_rgba(0,0,0,0.5)] sm:text-7xl lg:text-[6.5rem]">
      {heroLines.map((line, i) => (
        <Reveal as="span" delay={(i === 0 ? 1 : 2) as 1 | 2} class="block">
          {i === heroLines.length - 1 ? (
            // Arabic has no italic glyphs — browsers fake-slant it, which
            // reads as broken. Emphasis stays color-only in Arabic.
            <em class:list={['not-italic text-gold-light', lang === 'en' && 'italic']}>{line}</em>
          ) : line}
        </Reveal>
      ))}
    </h1>

    <Reveal delay={3} class="mt-7 max-w-lg text-lg leading-relaxed text-ivory/75">
      <p>{dict.home.heroSub}</p>
    </Reveal>

    <Reveal delay={4} class="mt-9 flex flex-wrap items-center gap-4">
      <Button href={localePath(lang, '/contact')} variant="gold">{dict.cta.getQuote}</Button>
      <Button href={company.whatsappLink} variant="ghost-light">{dict.cta.whatsapp}</Button>
    </Reveal>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-px bg-gold/50" aria-hidden="true"></div>
</section>
