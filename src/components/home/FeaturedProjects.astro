---
// Home page "Recent Work" section: a horizontal strip of 3 ArchImage cards,
// each linking to the full projects listing page.
import { t, localePath, type Lang } from '../../i18n';
import SectionHeading from '../SectionHeading.astro';
import Reveal from '../Reveal.astro';
import ArchImage from '../ArchImage.astro';
import Button from '../Button.astro';
import project01 from '../../assets/img/project-01.jpg';
import project03 from '../../assets/img/project-03.jpg';
import project05 from '../../assets/img/project-05.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const projectsHref = localePath(lang, '/projects');

const featured = [
  { src: project01, altEn: 'Completed commercial fitout project', altAr: 'مشروع تشطيبات تجارية منجز' },
  { src: project03, altEn: 'Completed joinery and interior project', altAr: 'مشروع نجارة وتشطيبات داخلية منجز' },
  { src: project05, altEn: 'Completed signage installation project', altAr: 'مشروع تركيب لوحات إعلانية منجز' },
];
---

<section class="bg-ivory">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <Reveal>
        <SectionHeading title={dict.home.featuredTitle} sub={dict.home.featuredSub} />
      </Reveal>
      <Reveal delay={1}>
        <Button href={projectsHref} variant="outline">{dict.cta.viewAll}</Button>
      </Reveal>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {featured.map((item, i) => (
        <Reveal delay={((i % 3) + 1) as 1 | 2 | 3}>
          <a href={projectsHref} class="group block transition-transform duration-500 hover:-translate-y-1">
            <ArchImage
              src={item.src}
              alt={lang === 'ar' ? item.altAr : item.altEn}
              class="shadow-sm transition-shadow duration-500 group-hover:shadow-xl"
            />
          </a>
        </Reveal>
      ))}
    </div>
  </div>
</section>
