---
// Home page "Why Golden Pillar" section — Survey Line direction: a real
// work photograph with the stats overlaid on it as a site data plate
// (matching the title-block/data-plate language used everywhere else on
// the site), differentiator points each marked with a small survey
// reticle instead of a plain vertical rule.
import { t, type Lang } from '../../i18n';
import { company } from '../../data/company';
import SectionHeading from '../SectionHeading.astro';
import Reveal from '../Reveal.astro';
import { Image } from 'astro:assets';
import whyImg from '../../assets/img/about-02.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<section class="relative overflow-hidden bg-charcoal">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-16 lg:py-32">
    <Reveal class="relative">
      <div class="relative aspect-4/5 overflow-hidden rounded-sm">
        <Image
          src={whyImg}
          alt=""
          widths={[500, 800, 1100]}
          sizes="(min-width: 1024px) 42vw, 90vw"
          class="h-full w-full object-cover"
        />
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <span class="absolute start-3 top-3 h-6 w-6 border-t-2 border-s-2 border-gold-light/60"></span>
          <span class="absolute end-3 bottom-3 h-6 w-6 border-b-2 border-e-2 border-gold-light/60"></span>
        </div>

        {/* Site data plate — overlaid on the photo like a real nameplate,
            not a separate box floating in the text column. */}
        <div class="absolute inset-x-3 bottom-3 border border-gold-light/40 bg-charcoal/80 font-mono text-sm backdrop-blur-sm sm:inset-x-4 sm:bottom-4">
          {[
            { label: dict.home.statsLabels.years, value: company.stats.years },
            { label: dict.home.statsLabels.projects, value: company.stats.projects },
            { label: dict.home.statsLabels.clients, value: company.stats.clients },
          ].map((row, i) => (
            <div
              class:list={[
                'flex items-center justify-between gap-4 px-4 py-2.5',
                i > 0 && 'border-t border-gold-light/20',
              ]}
            >
              <span class="text-xs uppercase tracking-[0.1em] text-ivory/60 sm:text-sm">{row.label}</span>
              <span class="text-gold-light" data-counter={row.value}>0</span>
            </div>
          ))}
        </div>
      </div>
    </Reveal>

    <div>
      <Reveal>
        <SectionHeading title={dict.home.whyTitle} dark />
      </Reveal>

      <div class="mt-10 space-y-8">
        {dict.home.whyPoints.map((point, i) => (
          <Reveal delay={(i + 1) as 1 | 2 | 3} class="flex gap-4">
            <span
              class="mt-1.5 flex h-6 w-6 shrink-0 items-center justify-center text-gold-light"
              aria-hidden="true"
            >
              <svg viewBox="0 0 16 16" class="h-full w-full" fill="none" stroke="currentColor" stroke-width="1.2">
                <circle cx="8" cy="8" r="2" />
                <circle cx="8" cy="8" r="6" />
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold text-ivory">{point.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ivory/65">{point.body}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </div>
</section>
