---
// Home page "Why Golden Pillar" section: a real work photograph on one
// side, differentiator points + stat counters stacked on the other — no
// numbered circle badges, no boxed stat panel, no centered heading.
import { t, type Lang } from '../../i18n';
import { company } from '../../data/company';
import SectionHeading from '../SectionHeading.astro';
import Reveal from '../Reveal.astro';
import { Image } from 'astro:assets';
import whyImg from '../../assets/img/about-02.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<section class="relative overflow-hidden bg-charcoal">
  <div class="pointer-events-none absolute inset-6 hidden sm:inset-10 sm:block" aria-hidden="true">
    <span class="absolute end-0 bottom-0 h-7 w-7 border-b-2 border-e-2 border-gold-light/40"></span>
  </div>
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16 lg:py-32">
    <Reveal class="relative lg:-mb-16 lg:mt-16">
      <Image
        src={whyImg}
        alt=""
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 40vw, 90vw"
        class="aspect-4/5 w-full rounded-sm object-cover shadow-xl"
      />
      <div class="pointer-events-none absolute -inset-3 -z-10 border border-gold-light/30" aria-hidden="true"></div>
    </Reveal>

    <div>
      <Reveal>
        <SectionHeading title={dict.home.whyTitle} dark />
      </Reveal>

      <div class="mt-10 space-y-8">
        {dict.home.whyPoints.map((point, i) => (
          <Reveal delay={(i + 1) as 1 | 2 | 3} class="border-s-2 border-gold-light/40 ps-5">
            <h3 class="font-display text-lg font-semibold text-ivory">{point.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ivory/65">{point.body}</p>
          </Reveal>
        ))}
      </div>

      {/* Data plate — a bordered spec-table reading like a real equipment
          nameplate or a drawing's data block, not the generic "big
          number / small label / accent" stat-row template. */}
      <Reveal delay={4} class="mt-12 border border-gold-light/30 font-mono text-sm">
        {[
          { label: dict.home.statsLabels.years, value: company.stats.years },
          { label: dict.home.statsLabels.projects, value: company.stats.projects },
          { label: dict.home.statsLabels.clients, value: company.stats.clients },
        ].map((row, i) => (
          <div
            class:list={[
              'flex items-center justify-between gap-4 px-4 py-3',
              i > 0 && 'border-t border-gold-light/20',
            ]}
          >
            <span class="uppercase tracking-[0.1em] text-ivory/60">{row.label}</span>
            <span class="text-gold-light" data-counter={row.value}>0</span>
          </div>
        ))}
      </Reveal>
    </div>
  </div>
</section>
