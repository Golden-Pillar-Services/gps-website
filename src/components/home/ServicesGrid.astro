---
// Home page "What We Do" section: 4 photo-led tiles, staggered vertically
// so the row reads as a considered composition rather than an even grid.
// Each tile is the service photograph itself with title/tagline overlaid
// on a gradient — no card border, no white background, no shadow-box —
// replacing the generic icon-card-on-white pattern.
import { t, localePath, type Lang } from '../../i18n';
import { services, type ServiceSlug } from '../../data/services';
import SectionHeading from '../SectionHeading.astro';
import Reveal from '../Reveal.astro';
import { Image } from 'astro:assets';

import fitoutImg from '../../assets/img/service-fitout-2.jpg';
import cleaningImg from '../../assets/img/service-cleaning-2.jpg';
import joineryImg from '../../assets/img/service-joinery-2.jpg';
import signageImg from '../../assets/img/service-signage-2.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);

const images: Record<ServiceSlug, ImageMetadata> = {
  'fitout-construction': fitoutImg,
  'cleaning-services': cleaningImg,
  joinery: joineryImg,
  signage: signageImg,
};

// Alternating vertical offset — the deliberate break from an even grid.
const offsets = ['lg:mt-0', 'lg:mt-10', 'lg:mt-4', 'lg:mt-14'];
---

<section class="bg-ivory">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 lg:py-32">
    <Reveal>
      <SectionHeading
        title={dict.home.servicesTitle}
        sub={dict.home.servicesSub}
      />
    </Reveal>

    <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service, i) => {
        const image = images[service.slug];
        const title = lang === 'ar' ? service.title.ar : service.title.en;
        const tagline = lang === 'ar' ? service.tagline.ar : service.tagline.en;
        return (
          <Reveal delay={((i % 4) + 1) as 1 | 2 | 3 | 4} class:list={[offsets[i]]}>
            <a
              href={localePath(lang, `/services/${service.slug}`)}
              class="group relative block aspect-3/4 overflow-hidden rounded-sm"
            >
              <Image
                src={image}
                alt=""
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 24vw, (min-width: 640px) 45vw, 90vw"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-linear-to-t from-charcoal/95 via-charcoal/35 to-charcoal/5" aria-hidden="true"></div>
              <div class="absolute inset-0 flex flex-col justify-end p-5">
                <h3 class="font-display text-lg font-semibold leading-tight text-ivory sm:text-xl">
                  {title}
                </h3>
                <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-ivory/70 sm:text-sm">
                  {tagline}
                </p>
                <span class="gp-learn-more mt-4 inline-flex w-fit items-center text-xs font-semibold uppercase tracking-wide text-gold-light">
                  {dict.cta.learnMore}
                </span>
              </div>
              <div class="pointer-events-none absolute inset-0 border border-ivory/0 transition-colors duration-300 group-hover:border-gold/60" aria-hidden="true"></div>
            </a>
          </Reveal>
        );
      })}
    </div>
  </div>
</section>

<style>
  .gp-learn-more {
    position: relative;
    padding-bottom: 2px;
  }
  .gp-learn-more::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    bottom: 0;
    height: 1.5px;
    width: 100%;
    background: var(--color-gold-light);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [dir='rtl'] .gp-learn-more::after {
    transform-origin: right;
  }
  a:hover .gp-learn-more::after,
  a:focus-visible .gp-learn-more::after {
    transform: scaleX(1);
  }
</style>
