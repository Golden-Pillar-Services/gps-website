---
import { altPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  currentPath: string;
  class?: string;
}

const { lang, currentPath, class: className = '' } = Astro.props;
const target = altPath(lang, currentPath);
const label = lang === 'ar' ? 'EN' : 'عربي';
const ariaLabel = lang === 'ar' ? 'Switch to English' : 'التبديل إلى العربية';
---

<a
  href={target}
  class={`inline-flex items-center rounded-full border border-gold/50 px-3 py-1.5 text-sm font-medium text-gold-light transition-colors hover:bg-gold hover:text-charcoal ${className}`}
  aria-label={ariaLabel}
  hreflang={lang === 'ar' ? 'en' : 'ar'}
>
  {label}
</a>
