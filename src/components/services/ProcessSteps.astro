---
// Four-step delivery process, numbered 01-04 with the numeral set in
// Fraunces (font-display) gold, connected by a hairline rule on desktop.
import type { Lang } from '../../i18n';
import Reveal from '../Reveal.astro';

interface Props {
  steps: { en: string; ar: string }[];
  lang: Lang;
  class?: string;
}

const { steps, lang, class: className } = Astro.props;
---

<ol class:list={['grid gap-8 sm:grid-cols-2 lg:grid-cols-4', className]}>
  {steps.map((step, i) => (
    <Reveal delay={((i % 4) + 1) as 1 | 2 | 3 | 4} as="li" class="relative">
      <span class="font-display text-4xl font-semibold text-gold">
        {String(i + 1).padStart(2, '0')}
      </span>
      <p class="mt-3 text-base font-semibold text-ink">
        {lang === 'ar' ? step.ar : step.en}
      </p>
    </Reveal>
  ))}
</ol>
