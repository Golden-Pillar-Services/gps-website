---
// 404 page: bilingual (EN + AR on one page), pillar watermark, link home.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PillarLineDraw from '../components/PillarLineDraw.astro';
import { en, ar, localePath } from '../i18n';

// Default to EN, but could be dynamic based on accept-language in the future
const lang = 'en';
const currentPath = '/404';
const dict = en;
const dictAr = ar;
---

<Base lang={lang} title={dict.notFound.title} description={dict.notFound.body} currentPath={currentPath} noindex>
  <section class="relative min-h-96 bg-ivory px-4 py-20 sm:px-6 sm:py-28">
    {/* Pillar watermark */}
    <div class="absolute inset-0 flex items-center justify-center overflow-hidden opacity-5 pointer-events-none">
      <PillarLineDraw class="w-96 h-auto text-ink" animate={false} />
    </div>

    <div class="relative mx-auto max-w-4xl">
      {/* English Section */}
      <div class="mb-16 text-center lg:mb-20">
        <h1 class="font-display text-7xl font-semibold text-ink sm:text-8xl">404</h1>
        <h2 class="mt-6 font-display text-3xl font-semibold text-ink sm:text-4xl">{dict.notFound.title}</h2>
        <p class="mt-4 text-lg text-stone-dark">{dict.notFound.body}</p>
        <div class="mt-8">
          <Button href={localePath('en', '/')} variant="gold">
            {dict.notFound.backHome}
          </Button>
        </div>
      </div>

      {/* Language Divider */}
      <div class="mx-auto mb-16 flex max-w-xs items-center gap-4 lg:mb-20">
        <div class="h-px flex-1 bg-gold/30"></div>
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-gold/60">EN / AR</span>
        <div class="h-px flex-1 bg-gold/30"></div>
      </div>

      {/* Arabic Section */}
      <div dir="rtl" lang="ar" class="text-center">
        <h2 class="font-display text-3xl font-semibold text-ink sm:text-4xl">{dictAr.notFound.title}</h2>
        <p class="mt-4 text-lg text-stone-dark">{dictAr.notFound.body}</p>
        <div class="mt-8">
          <Button href={localePath('ar', '/')} variant="gold">
            {dictAr.notFound.backHome}
          </Button>
        </div>
      </div>
    </div>
  </section>
</Base>
