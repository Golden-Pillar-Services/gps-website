---
// Contact page: WhatsApp (primary), phone, email, address, hours, CR number,
// and embedded map (lazy-loaded with localized title).
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Reveal from '../../components/Reveal.astro';
import WhatsAppChooser from '../../components/WhatsAppChooser.astro';
import PillarDivider from '../../components/PillarDivider.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getImage } from 'astro:assets';
import { langs, t, localePath, type Lang } from '../../i18n';
import { company } from '../../data/company';
import contactImg from '../../assets/img/service-fitout-3.jpg';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const currentPath = localePath(lang, '/contact');
const ogImage = await getImage({ src: contactImg, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

const site = Astro.site ?? new URL('https://goldenpillar.om');
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: dict.nav.home, item: new URL(`/${lang}/`, site).toString() },
    { '@type': 'ListItem', position: 2, name: dict.nav.contact, item: new URL(`/${lang}/contact/`, site).toString() },
  ],
};
---

<Base
  lang={lang}
  title={dict.contact.seoTitle}
  description={dict.contact.seoDescription}
  currentPath={currentPath}
  ogImage={ogImage.src}
  structuredData={[breadcrumbJsonLd]}
>
  <PageHero lang={lang} sheetNo="05" eyebrow={dict.nav.contact} title={dict.contact.title} sub={dict.contact.sub} image={contactImg} />

  {/* Contact Channels + Map */}
  <section class="bg-ivory">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-28">
      {/* Contact Channels */}
      <Reveal>
        <div>
          <h2 class="mb-10 font-display text-2xl font-semibold text-ink">{dict.contact.channelsTitle}</h2>

          {/* WhatsApp - Primary CTA, opens a chooser (two live numbers) */}
          <div class="mb-10">
            <WhatsAppChooser lang={lang} variant="gold" class="w-full text-base py-4">
              {dict.contact.whatsappLabel}
            </WhatsAppChooser>
          </div>

          {/* Sheet data table — reads as a drawing's metadata block
              (label / value rows) rather than repeated h3+p stacks. Two
              live phone lines get their own rows, each independently
              callable. */}
          <div class="border border-gold/25 font-mono text-sm">
            {company.phones.map((p, i) => (
              <a
                href={p.tel}
                class:list={[
                  'flex flex-col gap-1 px-4 py-3 transition-colors hover:bg-sand/50 sm:flex-row sm:items-center sm:justify-between sm:gap-4',
                  i > 0 && 'border-t border-gold/15',
                ]}
              >
                <span class="text-xs uppercase tracking-[0.1em] text-stone-dark">{p.name}</span>
                <span dir="ltr" class="text-ink">{p.label}</span>
              </a>
            ))}
            {[
              { label: dict.contact.emailLabel, value: company.email, href: `mailto:${company.email}` },
              { label: dict.contact.addressLabel, value: company.address[lang] },
              { label: dict.contact.hoursLabel, value: company.hours[lang] },
              { label: dict.contact.crLabel, value: company.crNumber },
            ].map((row) => {
              const Tag = row.href ? 'a' : 'div';
              return (
                <Tag
                  href={row.href}
                  class:list={[
                    'flex flex-col gap-1 border-t border-gold/15 px-4 py-3 transition-colors sm:flex-row sm:items-center sm:justify-between sm:gap-4',
                    row.href && 'hover:bg-sand/50',
                  ]}
                >
                  <span class="text-xs uppercase tracking-[0.1em] text-stone-dark">{row.label}</span>
                  <span class:list={['text-ink', row.href && 'group-hover:text-gold']}>{row.value}</span>
                </Tag>
              );
            })}
          </div>
        </div>
      </Reveal>

      {/* Map */}
      <Reveal delay={1}>
        <div class="relative h-full min-h-96 overflow-hidden rounded-sm border border-gold/20 bg-sand/40">
          <iframe
            src={company.mapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0; position: absolute; inset: 0;"
            allowfullscreen=""
            loading="lazy"
            title={dict.contact.mapTitle}
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </Reveal>
    </div>
  </section>

  <PillarDivider />

  <CtaBand lang={lang} />
</Base>
