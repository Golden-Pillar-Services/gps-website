---
// Contact page: WhatsApp (primary), phone, email, address, hours, CR number,
// and embedded map (lazy-loaded with localized title).
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import Button from '../../components/Button.astro';
import PillarDivider from '../../components/PillarDivider.astro';
import CtaBand from '../../components/CtaBand.astro';
import { langs, t, localePath, type Lang } from '../../i18n';
import { company } from '../../data/company';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const currentPath = localePath(lang, '/contact');
---

<Base lang={lang} title={dict.contact.title} description={dict.contact.sub} currentPath={currentPath}>
  {/* Hero */}
  <section class="border-b border-gold/30 bg-sand">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <Reveal>
        <SectionHeading
          as="h1"
          eyebrow={dict.nav.contact}
          title={dict.contact.title}
          sub={dict.contact.sub}
          class="max-w-2xl"
        />
      </Reveal>
    </div>
  </section>

  {/* Contact Channels + Map */}
  <section class="bg-ivory">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-28">
      {/* Contact Channels */}
      <Reveal>
        <div>
          <h2 class="mb-10 font-display text-2xl font-semibold text-ink">{dict.contact.channelsTitle}</h2>

          {/* WhatsApp - Primary CTA */}
          <div class="mb-10">
            <Button href={company.whatsappLink} variant="gold" class="w-full justify-center text-base py-4">
              {dict.contact.whatsappLabel}
            </Button>
            <a href={company.whatsappLink} class="mt-3 inline-block text-sm text-stone-dark transition-colors hover:text-gold">
              {company.whatsapp}
            </a>
          </div>

          {/* Phone */}
          <div class="mb-10">
            <a href={`tel:${company.phone.replace(/\s/g, '')}`} class="inline-block">
              <h3 class="font-semibold text-ink">{dict.contact.phoneLabel}</h3>
              <p class="mt-2 text-stone-dark hover:text-gold transition-colors">{company.phone}</p>
            </a>
          </div>

          {/* Email */}
          <div class="mb-10">
            <a href={`mailto:${company.email}`} class="inline-block">
              <h3 class="font-semibold text-ink">{dict.contact.emailLabel}</h3>
              <p class="mt-2 text-stone-dark hover:text-gold transition-colors">{company.email}</p>
            </a>
          </div>

          {/* Address */}
          <div class="mb-10">
            <h3 class="font-semibold text-ink">{dict.contact.addressLabel}</h3>
            <p class="mt-2 text-stone-dark">{company.address[lang]}</p>
          </div>

          {/* Hours */}
          <div class="mb-10">
            <h3 class="font-semibold text-ink">{dict.contact.hoursLabel}</h3>
            <p class="mt-2 text-stone-dark">{company.hours[lang]}</p>
          </div>

          {/* CR Number */}
          <div>
            <h3 class="font-semibold text-ink">{dict.contact.crLabel}</h3>
            <p class="mt-2 text-stone-dark">{company.crNumber}</p>
          </div>
        </div>
      </Reveal>

      {/* Map */}
      <Reveal delay={1}>
        <div class="relative h-full min-h-96 overflow-hidden rounded-sm border border-gold/20 bg-sand/40">
          <iframe
            src={company.mapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0; position: absolute; inset: 0;"
            allowfullscreen=""
            loading="lazy"
            title={dict.contact.mapTitle}
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </Reveal>
    </div>
  </section>

  <PillarDivider />

  <CtaBand lang={lang} />
</Base>
