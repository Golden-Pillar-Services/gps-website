---
// Services index: sand hero + 4 large alternating rows (image / scope
// teaser / link to the detail page), one per trade.
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Reveal from '../../../components/Reveal.astro';
import ArchImage from '../../../components/ArchImage.astro';
import Button from '../../../components/Button.astro';
import CtaBand from '../../../components/CtaBand.astro';
import IconFitout from '../../../components/icons/IconFitout.astro';
import IconCleaning from '../../../components/icons/IconCleaning.astro';
import IconJoinery from '../../../components/icons/IconJoinery.astro';
import IconSignage from '../../../components/icons/IconSignage.astro';
import { langs, t, localePath, type Lang } from '../../../i18n';
import { services, type ServiceSlug } from '../../../data/services';
import type { ImageMetadata } from 'astro';

import fitoutImg from '../../../assets/img/service-fitout-1.jpg';
import cleaningImg from '../../../assets/img/service-cleaning-1.jpg';
import joineryImg from '../../../assets/img/service-joinery-1.jpg';
import signageImg from '../../../assets/img/service-signage-1.jpg';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const currentPath = localePath(lang, '/services');

const icons: Record<ServiceSlug, typeof IconFitout> = {
  'fitout-construction': IconFitout,
  'cleaning-services': IconCleaning,
  joinery: IconJoinery,
  signage: IconSignage,
};

const images: Record<ServiceSlug, ImageMetadata> = {
  'fitout-construction': fitoutImg,
  'cleaning-services': cleaningImg,
  joinery: joineryImg,
  signage: signageImg,
};
---

<Base lang={lang} title={dict.servicesPage.title} description={dict.servicesPage.sub} currentPath={currentPath}>
  <PageHero lang={lang} eyebrow={dict.nav.services} title={dict.servicesPage.title} sub={dict.servicesPage.sub} image={fitoutImg} />

  {/* Alternating service rows */}
  <section class="bg-ivory">
    <div class="mx-auto max-w-6xl divide-y divide-gold/15 px-4 sm:px-6">
      {services.map((service, i) => {
        const Icon = icons[service.slug];
        const image = images[service.slug];
        const href = localePath(lang, `/services/${service.slug}`);
        const reversed = i % 2 === 1;
        return (
          <div
            class:list={[
              'grid items-center gap-10 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24',
            ]}
          >
            <Reveal class:list={[reversed ? 'lg:order-2' : '']}>
              <a href={href} class="group block">
                <ArchImage
                  src={image}
                  alt={lang === 'ar' ? service.title.ar : service.title.en}
                  class="shadow-sm transition-shadow duration-500 group-hover:shadow-xl"
                  sizes="(min-width: 1024px) 50vw, 100vw"
                />
              </a>
            </Reveal>

            <Reveal delay={1} class:list={[reversed ? 'lg:order-1' : '']}>
              <Icon class="h-9 w-9 text-gold" />
              <h2 class="mt-5 font-display text-2xl font-semibold text-ink sm:text-3xl">
                {lang === 'ar' ? service.title.ar : service.title.en}
              </h2>
              <p class="mt-3 text-base text-stone-dark sm:text-lg">
                {lang === 'ar' ? service.tagline.ar : service.tagline.en}
              </p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {(lang === 'ar' ? service.scope.ar : service.scope.en).slice(0, 3).map((item) => (
                  <li class="rounded-full border border-gold/30 px-3 py-1 text-xs font-medium text-stone-dark">
                    {item}
                  </li>
                ))}
              </ul>
              <Button href={href} variant="outline" class="mt-8">
                {dict.cta.learnMore}
              </Button>
            </Reveal>
          </div>
        );
      })}
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
