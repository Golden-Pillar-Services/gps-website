---
// TEMPORARY smoke-test page — verifies Base.astro renders correctly in both
// languages. Replaced with the real home page in a later task.
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/Reveal.astro';
import Button from '../../components/Button.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Stat from '../../components/Stat.astro';
import ArchImage from '../../components/ArchImage.astro';
import IconFitout from '../../components/icons/IconFitout.astro';
import IconCleaning from '../../components/icons/IconCleaning.astro';
import IconJoinery from '../../components/icons/IconJoinery.astro';
import IconSignage from '../../components/icons/IconSignage.astro';
import { langs, t, localePath } from '../../i18n';
import heroFitout from '../../assets/img/hero-fitout.jpg';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const dict = t(lang);
const currentPath = localePath(lang, '/');
---

<Base
  lang={lang}
  title="Golden Pillar Services"
  description={dict.home.heroSub}
  currentPath={currentPath}
>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <h1 class="whitespace-pre-line font-display text-4xl font-semibold text-ink sm:text-5xl">
      {dict.home.heroTitle}
    </h1>
    <p class="mt-6 text-lg text-stone">{dict.home.heroSub}</p>
  </section>

  {/* TEMPORARY: motion-system smoke test for Task 4. Remove once real
      page-building tasks add their own reveal/counter/atom usage. */}
  <section class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
    <Reveal>
      <SectionHeading
        eyebrow="Motion system"
        title="Blur scroll-reveal demo"
        sub="This block, and the ones below it, fade + rise + blur-in as they enter the viewport."
      />
    </Reveal>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <Reveal delay={1} class="rounded-lg border border-gold/20 bg-sand/40 p-6">
        <p class="text-sm text-stone">Card one — no stagger delay.</p>
      </Reveal>
      <Reveal delay={2} class="rounded-lg border border-gold/20 bg-sand/40 p-6">
        <p class="text-sm text-stone">Card two — 160ms stagger.</p>
      </Reveal>
      <Reveal delay={3} class="rounded-lg border border-gold/20 bg-sand/40 p-6">
        <p class="text-sm text-stone">Card three — 240ms stagger.</p>
      </Reveal>
    </div>

    <Reveal delay={4} class="mt-12 grid gap-6 sm:grid-cols-3" as="div">
      <Stat value={1240} label="Projects delivered" suffix="+" />
      <Stat value={98} label="Client satisfaction" suffix="%" />
      <Stat value={15} label="Years in Oman" />
    </Reveal>

    <Reveal delay={5} class="mt-12 flex flex-wrap items-center justify-center gap-4">
      <Button href={localePath(lang, '/contact')} variant="gold">Gold button</Button>
      <Button href={localePath(lang, '/contact')} variant="outline">Outline button</Button>
    </Reveal>

    <Reveal delay={6} class="mt-6 flex items-center justify-center rounded-lg bg-charcoal p-6">
      <Button href={localePath(lang, '/contact')} variant="ghost-light">Ghost-light button</Button>
    </Reveal>
  </section>

  {/* TEMPORARY: icon + imagery pipeline smoke test for Task 5. Remove once
      the real home/services pages wire icons and ArchImage in context. */}
  <section class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
    <Reveal>
      <SectionHeading
        eyebrow="Icons & imagery"
        title="Service icons + ArchImage demo"
        sub="Hand-drawn pillar-stroke icons, and a photo clipped by the arch-top mask."
      />
    </Reveal>

    <Reveal delay={1} class="mt-10 flex flex-wrap items-center justify-center gap-10 text-gold">
      <IconFitout class="h-12 w-12" />
      <IconCleaning class="h-12 w-12" />
      <IconJoinery class="h-12 w-12" />
      <IconSignage class="h-12 w-12" />
    </Reveal>

    <Reveal delay={2} class="mt-10 mx-auto max-w-sm">
      <ArchImage src={heroFitout} alt="Commercial fitout interior" loading="eager" />
    </Reveal>
  </section>
</Base>
