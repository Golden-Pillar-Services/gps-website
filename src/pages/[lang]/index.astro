---
// Home page: Hero, ServicesGrid, WhyUs, FeaturedProjects, CtaBand.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import ServicesGrid from '../../components/home/ServicesGrid.astro';
import WhyUs from '../../components/home/WhyUs.astro';
import FeaturedProjects from '../../components/home/FeaturedProjects.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getImage } from 'astro:assets';
import { langs, t, localePath } from '../../i18n';
import heroImg from '../../assets/img/hero-fitout.jpg';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const dict = t(lang);
const currentPath = localePath(lang, '/');
const ogImage = await getImage({ src: heroImg, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<Base
  lang={lang}
  title={dict.home.seoTitle}
  description={dict.home.seoDescription}
  currentPath={currentPath}
  ogImage={ogImage.src}
>
  <Hero lang={lang} />
  <ServicesGrid lang={lang} />
  <WhyUs lang={lang} />
  <FeaturedProjects lang={lang} />
  <CtaBand lang={lang} />
</Base>
