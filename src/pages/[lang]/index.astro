---
// Home page: Hero, ServicesGrid, WhyUs, FeaturedProjects, CtaBand.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/home/Hero.astro';
import ServicesGrid from '../../components/home/ServicesGrid.astro';
import WhyUs from '../../components/home/WhyUs.astro';
import FeaturedProjects from '../../components/home/FeaturedProjects.astro';
import CtaBand from '../../components/CtaBand.astro';
import { langs, t, localePath } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const dict = t(lang);
const currentPath = localePath(lang, '/');
const title = lang === 'ar' ? 'الركيزة الذهبية للخدمات' : 'Golden Pillar Services';
---

<Base lang={lang} title={title} description={dict.home.heroSub} currentPath={currentPath}>
  <Hero lang={lang} />
  <ServicesGrid lang={lang} />
  <WhyUs lang={lang} />
  <FeaturedProjects lang={lang} />
  <CtaBand lang={lang} />
</Base>
