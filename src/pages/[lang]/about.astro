---
// About page: story, mission/values, approach, and the animated journey
// timeline.
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import ArchImage from '../../components/ArchImage.astro';
import PillarDivider from '../../components/PillarDivider.astro';
import CtaBand from '../../components/CtaBand.astro';
import Timeline from '../../components/about/Timeline.astro';
import { langs, t, localePath, type Lang } from '../../i18n';

import about1 from '../../assets/img/about-01.jpg';
import about2 from '../../assets/img/about-02.jpg';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const currentPath = localePath(lang, '/about');
---

<Base lang={lang} title={dict.about.title} description={dict.about.sub} currentPath={currentPath}>
  {/* Hero */}
  <section class="border-b border-gold/30 bg-sand">
    <div class="mx-auto max-w-4xl px-4 py-24 text-center sm:px-6">
      <Reveal>
        <SectionHeading
          as="h1"
          eyebrow={dict.nav.about}
          title={dict.about.title}
          sub={dict.about.sub}
          class="mx-auto text-center"
        />
      </Reveal>
    </div>
  </section>

  {/* Story */}
  <section class="bg-ivory">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-28">
      <Reveal>
        <ArchImage
          src={about1}
          alt={lang === 'ar' ? dict.about.storyTitle : dict.about.storyTitle}
          class="shadow-sm"
        />
      </Reveal>
      <Reveal delay={1}>
        <SectionHeading eyebrow={dict.about.storyTitle} title={dict.about.storyTitle} class="mb-6" />
        <p class="text-base leading-relaxed text-stone sm:text-lg">{dict.about.storyP1}</p>
        <p class="mt-5 text-base leading-relaxed text-stone sm:text-lg">{dict.about.storyP2}</p>
      </Reveal>
    </div>
  </section>

  <PillarDivider />

  {/* Mission / values */}
  <section class="bg-ivory">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
      <Reveal>
        <SectionHeading
          eyebrow={dict.about.valuesTitle}
          title={dict.about.valuesTitle}
          class="mx-auto max-w-2xl text-center"
        />
      </Reveal>
      <div class="mt-14 grid gap-6 sm:grid-cols-3">
        {
          dict.about.values.map((value, i) => (
            <Reveal delay={(Math.min(i + 1, 6) as 1 | 2 | 3 | 4 | 5 | 6)}>
              <div class="h-full rounded-2xl border border-gold/20 bg-sand/40 p-8">
                <h3 class="font-display text-xl font-semibold text-ink">{value.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-stone">{value.body}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* Approach */}
  <section class="border-y border-gold/30 bg-sand">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-24">
      <Reveal>
        <ArchImage src={about2} alt={dict.about.approachTitle} class="shadow-sm" />
      </Reveal>
      <Reveal delay={1}>
        <SectionHeading eyebrow={dict.about.approachTitle} title={dict.about.approachTitle} class="mb-6" />
        <p class="text-base leading-relaxed text-stone sm:text-lg">{dict.about.approachBody}</p>
      </Reveal>
    </div>
  </section>

  {/* Journey timeline */}
  <section class="bg-ivory">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
      <Reveal>
        <SectionHeading
          eyebrow={dict.about.timelineTitle}
          title={dict.about.timelineTitle}
          class="mx-auto max-w-2xl text-center"
        />
      </Reveal>
      <div class="mt-16">
        <Timeline lang={lang} />
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />

  <script>
    import { initTimeline } from '../../scripts/timeline';
    initTimeline();
  </script>
</Base>
