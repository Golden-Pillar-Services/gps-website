---
// About page: story, mission/values, approach, and the animated journey
// timeline.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Reveal from '../../components/Reveal.astro';
import ArchImage from '../../components/ArchImage.astro';
import PillarDivider from '../../components/PillarDivider.astro';
import CtaBand from '../../components/CtaBand.astro';
import Timeline from '../../components/about/Timeline.astro';
import DimensionLine from '../../components/survey/DimensionLine.astro';
import { getImage } from 'astro:assets';
import { langs, t, localePath, type Lang } from '../../i18n';

import about1 from '../../assets/img/about-01.jpg';
import about2 from '../../assets/img/about-02.jpg';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const currentPath = localePath(lang, '/about');
const ogImage = await getImage({ src: about1, width: 1200, height: 630, fit: 'cover', format: 'jpg' });

const site = Astro.site ?? new URL('https://goldenpillar.om');
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: dict.nav.home, item: new URL(`/${lang}/`, site).toString() },
    { '@type': 'ListItem', position: 2, name: dict.nav.about, item: new URL(`/${lang}/about/`, site).toString() },
  ],
};
---

<Base
  lang={lang}
  title={dict.about.seoTitle}
  description={dict.about.seoDescription}
  currentPath={currentPath}
  ogImage={ogImage.src}
  structuredData={[breadcrumbJsonLd]}
>
  <PageHero lang={lang} sheetNo="02" eyebrow={dict.nav.about} title={dict.about.title} sub={dict.about.sub} image={about1} />

  {/* Story */}
  <section class="bg-ivory">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-28">
      <Reveal>
        <ArchImage
          src={about1}
          alt={lang === 'ar' ? dict.about.storyTitle : dict.about.storyTitle}
          class="shadow-sm"
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </Reveal>
      <Reveal delay={1}>
        <SectionHeading title={dict.about.storyTitle} class="mb-6" />
        <p class="text-base leading-relaxed text-stone-dark sm:text-lg">{dict.about.storyP1}</p>
        <p class="mt-5 text-base leading-relaxed text-stone-dark sm:text-lg">{dict.about.storyP2}</p>
      </Reveal>
    </div>
  </section>

  <PillarDivider />

  {/* Mission / values */}
  <section class="bg-charcoal">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
      <Reveal>
        <SectionHeading title={dict.about.valuesTitle} dark />
      </Reveal>
      <div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-3">
        {
          dict.about.values.map((value, i) => (
            <Reveal delay={(Math.min(i + 1, 6) as 1 | 2 | 3 | 4 | 5 | 6)}>
              <DimensionLine orientation="horizontal" class="h-3 w-16" />
              <h3 class="mt-3 font-display text-xl font-semibold text-ivory">{value.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ivory/65">{value.body}</p>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  {/* Approach */}
  <section class="border-y border-gold/30 bg-sand">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-24">
      <Reveal>
        <ArchImage
          src={about2}
          alt={dict.about.approachTitle}
          class="shadow-sm"
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </Reveal>
      <Reveal delay={1}>
        <SectionHeading title={dict.about.approachTitle} class="mb-6" />
        <p class="text-base leading-relaxed text-stone-dark sm:text-lg">{dict.about.approachBody}</p>
      </Reveal>
    </div>
  </section>

  {/* Journey timeline */}
  <section class="bg-ivory">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
      <Reveal>
        <SectionHeading
          title={dict.about.timelineTitle}
          class="mx-auto max-w-2xl text-center"
        />
      </Reveal>
      <div class="mt-16">
        <Timeline lang={lang} />
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />

  <script>
    import { initTimeline } from '../../scripts/timeline';
    initTimeline();
  </script>
</Base>
