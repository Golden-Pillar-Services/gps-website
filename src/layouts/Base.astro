---
import '../styles/global.css';
import { dirFor, type Lang } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  currentPath: string;
}

const { lang, title, description, currentPath } = Astro.props;
const dir = dirFor(lang);
const site = Astro.site ?? new URL('https://goldenpillar.om');
const canonicalUrl = new URL(currentPath, site);
const enUrl = new URL(currentPath.replace(/^\/(en|ar)/, '/en'), site);
const arUrl = new URL(currentPath.replace(/^\/(en|ar)/, '/ar'), site);
const ogImage = new URL('/og-image.jpg', site);
---

<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_OM' : 'en_OM'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="bg-ivory text-ink">
    <Header lang={lang} currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat lang={lang} />

    <script>
      import { initReveals } from '../scripts/reveal';
      import { initCounters } from '../scripts/counters';

      initReveals();
      initCounters();
    </script>
  </body>
</html>
